# =============================================================================
# MedScope AI — environment template (copy to .env, never commit .env)
# Full reference: docs/Environment/Environment.md
# =============================================================================

# --- PostgreSQL (docker compose service: postgres) ---
POSTGRES_USER=medscope
POSTGRES_PASSWORD=medscope_dev
POSTGRES_DB=medscope_ai
POSTGRES_PORT=5432

# --- Backend (FastAPI / Alembic) ---
# Host "localhost" when uvicorn runs on the host; compose overrides DATABASE_URL in containers.
BACKEND_PORT=8000
DATABASE_URL=postgresql://medscope:medscope_dev@localhost:5432/medscope_ai

# --- Frontend Docker (nginx) ---
FRONTEND_PORT=3000

# --- JWT (change JWT_SECRET in production — RDO-020) ---
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- CORS (comma-separated browser origins) ---
# Include Vite dev (5173), Docker UI (3000), and prod domain when deploying.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost

# --- Logging (RNF-050 / RNF-051) ---
LOG_LEVEL=INFO
LOG_FORMAT=text
